[Unit]
Description=AstinusLab API Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=@@CURRENT_DIR@@
Environment=ASTINUSLAB_DATA_DIR=@@INSTALL_DIR@@
# stdout goes to the journal, so the in-app Logs page needs its own copy.
Environment=ASTINUSLAB_LOG_TO_FILE=true
Environment=ASTINUSLAB_API_HOST=127.0.0.1
Environment=ASTINUSLAB_API_PORT=8000
Environment=ASTINUSLAB_API_LOG_LEVEL=info
EnvironmentFile=-@@INSTALL_DIR@@/config/astinuslab.env
ExecStartPre=@@CURRENT_DIR@@/.venv/bin/python -m astinuslab.dbcli init
ExecStart=@@CURRENT_DIR@@/.venv/bin/python -m astinuslab.serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astinuslab-api

# Privilege hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadOnlyPaths=@@INSTALL_DIR@@
@@PROTECT_HOME@@
UMask=0007
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# The API stages uploaded and downloaded images (ui/image_routes.py) and
# rewrites catalog YAML (ui/jobs_routes.py) and publishes validated manual ISFs.
ReadWritePaths=@@STORAGE_ROOT@@ @@INSTALL_DIR@@/config @@INSTALL_DIR@@/images/definitions @@INSTALL_DIR@@/vol3/symbols

[Install]
WantedBy=multi-user.target
