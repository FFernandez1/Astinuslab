# AstinusLab environment overrides.
# Copy to config/astinuslab.env and adjust as needed.
# Every ASTINUSLAB_* variable here overrides the same setting in astinuslab.toml
# (precedence: env > toml > code defaults). Loaded by ./astinuslab.sh and by the
# systemd units via EnvironmentFile.

ASTINUSLAB_API_HOST=127.0.0.1
ASTINUSLAB_API_PORT=8000
ASTINUSLAB_API_LOG_LEVEL=info

# Single-admin API auth. Required before binding to a non-loopback API host.
ASTINUSLAB_AUTH_ENABLED=false
# ASTINUSLAB_ADMIN_API_TOKEN_HASH=sha256:<64-hex-sha256-of-random-token>
ASTINUSLAB_ALLOW_UNSAFE_NETWORK_BIND_WITHOUT_AUTH=false
# Comma-separated exact origins or JSON list. Leave empty for loopback origins
# at ASTINUSLAB_API_PORT only.
# ASTINUSLAB_BROWSER_ALLOWED_ORIGINS=https://astinuslab.example

ASTINUSLAB_LIBVIRT_URI=qemu:///system
ASTINUSLAB_LIBVIRT_NETWORK=default

# Product-level VM cap (see [orchestration] in astinuslab.toml).
# ASTINUSLAB_MAX_CONCURRENT_VMS=4

# List-typed settings accept comma-separated values or a JSON array:
# ASTINUSLAB_VOL3_ISF_MIRROR_URLS=https://mirror-a.example/isf,https://mirror-b.example/isf
# Dict-typed settings accept a JSON object:
# ASTINUSLAB_VOL3_PROVIDER_TIMEOUTS={"prebuilt_isf": 60, "debuginfod": 900}

# Full list of overridable variables: docs/usage/configuration.md (environment variable reference).

# CELERY_TASK_ALWAYS_EAGER=1  — TEST ONLY. Runs Celery tasks synchronously inside
# the calling process (API request handlers). Never set in a deployment.
