  "topology": [],
  "experience": {
    "runbook_path": "experience/runbook.md",
    "objectives": [
      "Verify routed HTTP reaches the protected Target through OpenWrt.",
      "Show a healthy SSH listener is blocked and the firewall deny counter increases.",
      "Reboot the firewall and prove filtering remains in effect."
    ],
    "hints": [
      "Set the return route as well as the entry-client route.",
      "Check the service is healthy before interpreting a timeout as filtering.",
      "A configured firewall is guest state, not a property of a two-NIC recipe."
    ],
    "checkpoints": [
      {
        "operation": "assert",
        "scope": "guest",
        "vm_id": "firewall",
        "path": "readiness.json",
        "expected": "v1:training-openwrt-firewall:ready",
        "timeout_seconds": 30
      },
      {
        "operation": "assert",
        "scope": "guest",
        "vm_id": "protected-web",
        "path": "readiness.json",
        "expected": "v1:training-protected-web:ready",
        "timeout_seconds": 30
      }
    ]
  }
